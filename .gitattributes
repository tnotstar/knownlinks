# Set the default behavior to handle all files as text and normalize line endings (LF) in the repository.
* text=auto

# Declare files that will always have LF line endings on checkout to ensure consistency across Linux, WSL2, macOS, and Windows.
*.py text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Denote files that are binary and should not have their line endings modified.
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
